  },
  "dependencies": {
    "@pactagent/core": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-native": ">=0.76.0"
  },
  "devDependencies": {
    "@types/react-test-renderer": "19.1.0",
    "react": "^19.2.0",
    "react-native": "^0.81.0",
    "react-test-renderer": "19.2.0",
    "vitest": "^3.2.7"
  },
  "files": [
    "dist",
    "LICENSE"
  ]
