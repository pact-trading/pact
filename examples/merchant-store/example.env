# Copy to .env.local. These stay on the server and never reach the browser.
PACT_SECRET_KEY=
PACT_WEBHOOK_SECRET=
# Optional. Defaults to https://api.pactagent.app.
PACT_API_URL=
# Optional: also offer a hosted product link, for example https://pay.pactagent.app and prod_123.
PACT_CHECKOUT_ORIGIN=
PACT_PRODUCT_ID=
# Optional. Defaults to ./merchant-store.sqlite.
PACT_STORE_DB=
# Optional: answer the first webhook with 503 to demonstrate retries.
PACT_DEMO_REFUSE_FIRST_WEBHOOK=
