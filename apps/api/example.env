PORT=3001
DATABASE_PATH=./settle.sqlite
PUBLIC_BASE_URL=http://localhost:3000
BOOTSTRAP_MERCHANT_ADDRESS=0x0000000000000000000000000000000000000001
CHAIN_ADAPTER=fake
# For live chain access, set CHAIN_ADAPTER=viem and provide every value below, from the deployment
# record (scripts/testnet/api-env.ts writes them for you).
RPC_URL=
# Pact's relayer: it sends every transaction, pays all gas and receives every fee in USDT.
RELAYER_PRIVATE_KEY=
FEE_SCHEDULE_ADDRESS=
ROUTER_ADDRESS=
ESCROW_ADDRESS=
SUBSCRIPTION_ADDRESS=
DEPLOYMENT_BLOCK=0
CONFIRMATIONS=1
# WebSocket RPC for new heads (wss://rpc.testnet.whitechain.io/ws): index as each block lands.
# RPC_WS_URL=
# Where the ledger is written (accounting, captured, payment.captured): latest | safe | finalized.
# Whatever it is, a payment is reported `confirmed` within a block. Use safe or finalized for real money.
PACT_FINALITY=latest
# Optional extra relayer keys for Router intents, comma-separated. Each has its own nonce sequence.
# RELAYER_LANE_KEYS=
# One-signature (EIP-3009) checkout is on when the escrow supports it; set off to keep USDT permits.
# CHECKOUT_COLLECTOR=off
# Performance switches (default on): JSON-RPC batching, Multicall3 reads, pipelined writer slot.
# RPC_BATCH=0
# RPC_MULTICALL=0
# RELAYER_PIPELINE=0
# Minimum economic amount, in token units; keep aligned with Router.minAmount.
RELAYER_MIN_AMOUNT_MINOR=1000000
# Optional: gas Pact absorbs for each merchant's free calls (subscribe, cancel, approvals, listing),
# per UTC day: a starter allowance plus a share of the merchant's last 30 days of fees.
# SPONSORSHIP_STARTER_WEI_PER_DAY=50000000000000000
# SPONSORSHIP_REVENUE_SHARE_BPS=2500
# Optional: per-merchant daily gas the relayer sponsors for x402 calls, counted at worst case (default 0.05 WBT).
# X402_MERCHANT_DAILY_LIMIT_WEI=400000000000000000
# Optional treasury job: keeps the FeeSchedule's WBT price near the pool's and swaps fee USDT for gas.
# TREASURY_ENABLED=true
# TREASURY_MIN_WBT_WEI=200000000000000000
# TREASURY_SWAP_CHUNK_MINOR=20000000
# TREASURY_MAX_SLIPPAGE_BPS=300
# TREASURY_SWEEP_ALERT_MINOR=500000000
# Optional read-only Foundry out directory (default: ../contracts/out).
# CONTRACT_ARTIFACTS_DIR=/absolute/path/to/contracts/out

# Optional real email/passkey identity. Set both values to enable; partial config fails startup.
# App secret stays on API server only. Never use NEXT_PUBLIC_ for a secret.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Optional pinned PEM public verification key. Empty uses the app-scoped Privy JWKS.
PRIVY_VERIFICATION_KEY=

# Email notifications. Leave SMTP_HOST empty to log each email's recipient and subject instead of sending.
# Hostinger uses smtp.hostinger.com on port 465.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# Sender, for example: Pact <noreply@pactagent.app>
MAIL_FROM=

# Telegram notifications. Set both to enable; with either empty the feature is hidden and Telegram is never called.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
