# Copy to .env.local for `vercel dev`. Real values live in Vercel project
# settings; nothing secret belongs in this file or in git.

# Supabase REST endpoint and the key that bypasses row level security. The
# waitlist table has RLS enabled with no policies, so the anon key cannot read
# or write it and this service role key is the only credential that can.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Brevo transactional email.
BREVO_API_KEY=
WAITLIST_FROM_EMAIL=hello@your-domain.example
WAITLIST_FROM_NAME=Pact
WAITLIST_CONTACT_EMAIL=hello@your-domain.example

# Absolute, publicly reachable origin. Mail clients fetch the wordmark from it,
# so a relative path or a localhost URL leaves a broken image in the inbox.
WAITLIST_SITE_URL=https://your-domain.example
WAITLIST_X_URL=https://x.com/your-handle

# Salt for hashing submitter IPs. Any long random string; changing it resets the
# per-IP rate limit window, which is harmless.
WAITLIST_IP_SALT=
